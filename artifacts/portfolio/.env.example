# Copy to .env and fill with your Supabase client values for the frontend
# Vite exposes variables prefixed with VITE_ to the client bundle.

VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Notes:
# - Store the anon key only for client usage; keep service_role key on the server only.
# - After creating .env, run: `pnpm --filter @workspace/portfolio dev`
