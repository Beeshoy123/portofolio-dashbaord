# Copy this file to .env and fill real values (DO NOT commit .env to source control)
# Required for the api-server to start and to verify Supabase auth tokens.

# Postgres connection string (used by drizzle)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase project URL (example: https://xyzcompany.supabase.co)
SUPABASE_URL=https://<your-project>.supabase.co

# Supabase service role key (KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=service_role_XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: OpenRouter fallback key (only if you want GPT fallback)
OPENROUTER_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXX

# Optional: port for the server to listen on (defaults set in code if omitted)
PORT=3000

# Notes:
# - Never paste production secrets into chat.
# - Keep the real `.env` file out of version control.
# - After creating `.env`, restart the server: `node --enable-source-maps ./dist/index.mjs`
