# Copy this file to .secrets/api-server.env and fill in real values locally.
# Never commit .secrets/api-server.env.
DATABASE_URL=postgresql://postgres.gcyuahzdvaodrqijjqba:<encoded-password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
GEMINI_API_KEY=replace-with-gemini-api-key
# Optional Smart Advisor tuning; defaults preserve the current behavior.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=650
GEMINI_TIMEOUT_MS=45000
PORTFOLIO_OWNER_USER_ID=replace-with-supabase-user-uuid
PORT=8080
